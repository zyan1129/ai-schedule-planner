# Pick ONE provider and set its API key. Default is deepseek.
LLM_PROVIDER=deepseek

# --- DeepSeek (recommended: cheap, Chinese-friendly, reachable from China) ---
# Sign up: https://platform.deepseek.com/  (gives ~¥1 free credit = millions of tokens)
DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat

# --- Groq (truly free tier, very fast Llama 3.3 70B) ---
# Sign up: https://console.groq.com/
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (has :free models like DeepSeek V3 free) ---
# Sign up: https://openrouter.ai/
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# --- Gemini (original — free tier but 5 req/min, needs VPN from China) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash
