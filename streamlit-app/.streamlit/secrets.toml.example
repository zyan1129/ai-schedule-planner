# Copy to .streamlit/secrets.toml for local dev, or paste the same content into
# Streamlit Cloud -> your app -> Settings -> Secrets. Never commit the real file.
#
# Leave a section out and the app still runs:
#   no [auth]     -> guest mode, no login
#   no [supabase] -> login works, but data is kept for the session only

[auth]
# Must match an "Authorized redirect URI" on your Google OAuth client exactly.
# Local dev:        http://localhost:8501/oauth2callback
# Streamlit Cloud:  https://<your-app>.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-with-a-long-random-string"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
# Supabase dashboard -> Project Settings -> API
url = "https://xxxxxxxx.supabase.co"
# The service_role key (NOT the anon key). It stays on the Streamlit server.
service_role_key = "eyJhbGciOi..."
